# Persian AI Chatbox - Environment Variables
# این فایل را کپی کرده و به .env تغییر نام دهید
# هرگز فایل .env خود را روی گیت‌هاب قرار ندهید!

# پورت سرور
PORT=3000

# کلیدهای مدل‌های عمومی (پیش‌فرض) برای دسترسی بدون رمز کاربران

# 1. کلید API شرکت گوگل (برای مدل‌های Gemini مثل gemini-1.5-flash)
# دریافت رایگان از: https://aistudio.google.com/app/apikey
DEFAULT_GEMINI_KEY=your_gemini_api_key_here

# 2. کلید API شرکت Groq (برای مدل‌های Llama فوق‌سریع)
# دریافت رایگان از: https://console.groq.com/keys
DEFAULT_GROQ_KEY=your_groq_api_key_here

# تنظیمات ارسال ایمیل بازیابی رمز عبور (گزینه ۱: Resend API - فوق‌العاده سریع و پیشنهادی)
# RESEND_API_KEY=re_123456789abcdef...
# FROM_EMAIL=info@dastyarai.com

# تنظیمات ورود با گوگل (Google OAuth)
# VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# تنظیمات ارسال ایمیل (گزینه ۲: Gmail SMTP)
# SMTP_EMAIL=your_personal_gmail@gmail.com
# SMTP_PASSWORD=your_gmail_app_password

# (اختیاری) در صورت استفاده از پروکسی یا آدرس‌های دیگر
# DEFAULT_GROQ_BASE_URL=https://api.groq.com/openai/v1

# ============================================================
# [HARD] پاکسازی کامل دیتابیس از پنل مدیریت (خطرناک)
# ============================================================
# endpoint: POST /api/admin/reset-database
# در محیط production این مسیر به‌صورت پیش‌فرض غیرفعال است (403).
# برای فعال‌سازی موقت باید این متغیر را true کنید و سپس دوباره false یا حذف کنید.
# توجه: این عملیات تمام کاربران (جز ادمین فعلی)، سفارش‌ها، لایسنس‌ها،
# محصولات، گفتگوها، اخبار و تمام تراکنش‌های مالی را حذف می‌کند.
# ALLOW_ADMIN_DB_RESET=true