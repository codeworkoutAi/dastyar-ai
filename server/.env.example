# Persian AI Chatbox - Environment Variables
# این فایل را کپی کرده و به .env تغییر نام دهید
# هرگز فایل .env خود را روی گیت‌هاب قرار ندهید!

# پورت سرور
PORT=3000

# کلیدهای مدل‌های عمومی (پیش‌فرض) برای دسترسی بدون رمز کاربران

# 1. کلید API شرکت گوگل (برای مدل‌های Gemini مثل gemini-1.5-flash)
# دریافت رایگان از: https://aistudio.google.com/app/apikey
DEFAULT_GEMINI_KEY=your_gemini_api_key_here

# 2. کلید API شرکت Groq (برای مدل‌های Llama فوق‌سریع)
# دریافت رایگان از: https://console.groq.com/keys
DEFAULT_GROQ_KEY=your_groq_api_key_here

# (اختیاری) در صورت استفاده از پروکسی یا آدرس‌های دیگر
# DEFAULT_GROQ_BASE_URL=https://api.groq.com/openai/v1
