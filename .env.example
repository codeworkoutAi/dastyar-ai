# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & CORS
WEB_URL="https://dastyarai.com"
JWT_SECRET="your-secure-random-string-for-prod"

# Database (Turso)
TURSO_DATABASE_URL="libsql://your-db-url.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"

# Telegram Bot
PROXY_URL=""
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHANNEL_ID="@your_channel_id"
TELEGRAM_BOT_USERNAME="your_bot_username"
TELEGRAM_ADMIN_ID="123456789"

# Additional AI Providers
DEFAULT_GROQ_KEY="gsk_..."

# Email / SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_EMAIL="info@example.com"
SMTP_PASSWORD="your-smtp-password"
FROM_EMAIL="noreply@example.com"
RESEND_API_KEY="re_..."

# General Server Settings
PORT=3000
NODE_ENV="production"
WEBSITE_URL="https://dastyarai.com"

# SMS / OTP
KAVENEGAR_API_KEY="your-kavenegar-api-key"

# Authentication
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# AI Specific Models and Keys
GEMINI_SEARCH_KEY="AIza..."
GEMINI_GROUNDING_MODEL="gemini-1.5-pro"
GEMINI_INTENT_MODEL="gemini-1.5-flash"
